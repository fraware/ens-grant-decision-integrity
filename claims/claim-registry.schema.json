{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ens-gdi.local/claims/claim-registry.schema.json",
  "title": "ENS GDI Claim Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "claims"],
  "properties": {
    "registryVersion": {"type": "string", "const": "1"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "claimVersion",
        "title",
        "proposition",
        "module",
        "profileVersions",
        "requiredChecks",
        "requiredEvidence",
        "trustAssumptions",
        "doesNotEstablish",
        "status"
      ],
      "properties": {
        "claimId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z0-9][A-Z0-9._-]*$"},
        "claimVersion": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "proposition": {"type": "string", "minLength": 1},
        "module": {
          "type": "string",
          "enum": [
            "core-conformance",
            "source-artifacts",
            "phase2",
            "projection",
            "corpus",
            "funding",
            "release",
            "trust"
          ]
        },
        "profileVersions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "requiredEvidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "trustAssumptions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "doesNotEstablish": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "status": {"type": "string", "enum": ["active", "deprecated", "reserved"]},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
