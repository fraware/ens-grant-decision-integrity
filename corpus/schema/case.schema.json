{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-case.schema.json",
  "title": "ENS GDI Retrospective Corpus Case",
  "description": "Study metadata for reconstructability testing. A corpus case is not an applicant-merit assessment and validator success is not the study outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseVersion",
    "caseId",
    "title",
    "template",
    "historical",
    "sourceAccess",
    "selection",
    "sourceArtifacts",
    "recordSnapshots",
    "annotations",
    "verification",
    "review",
    "nonClaims"
  ],
  "properties": {
    "caseVersion": {"const": "1"},
    "caseId": {"type": "string", "minLength": 1, "maxLength": 128},
    "title": {"type": "string", "minLength": 1},
    "template": {"type": "boolean"},
    "historical": {"const": true},
    "sourceAccess": {
      "type": "string",
      "enum": ["public-only", "authorized-audit", "mixed"]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionClass", "selectionMethod", "inclusionRationale", "strata"],
      "properties": {
        "decisionClass": {
          "type": "string",
          "enum": [
            "eligibility-failure",
            "merit-rejection",
            "approved-award",
            "deferred",
            "suspended",
            "pending",
            "other"
          ]
        },
        "selectionMethod": {
          "type": "string",
          "enum": ["predeclared-stratum", "complete-frame", "other"]
        },
        "inclusionRationale": {"type": "string", "minLength": 1},
        "exclusionBoundary": {"type": "string", "minLength": 1},
        "strata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "hard-eligibility",
              "merit-decision",
              "approved-award",
              "committee-quorum",
              "recusal-or-conflict",
              "policy-change-or-ambiguity",
              "delivery-or-milestone",
              "public-private-separation",
              "ai-assisted-when-evidenced",
              "incomplete-public-record",
              "other"
            ]
          }
        }
      }
    },
    "sourceArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "role", "availability"],
        "properties": {
          "artifactId": {"type": "string", "minLength": 1, "maxLength": 128},
          "role": {
            "type": "string",
            "enum": ["governing-policy", "decision", "evidence", "challenge", "delivery", "other"]
          },
          "availability": {
            "type": "string",
            "enum": ["redistributable", "reference-only", "authorized-audit-only"]
          },
          "metadataPath": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "recordSnapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial"],
      "properties": {
        "initial": {"$ref": "#/$defs/snapshot"},
        "reconciled": {"$ref": "#/$defs/snapshot"}
      }
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/annotation"}
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialFindings", "recordChangedAfterReview"],
      "properties": {
        "initialFindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "recordChangedAfterReview": {"type": "boolean"},
        "changeRationale": {"type": "string", "minLength": 1},
        "finalErrors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "finalWarnings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"recordChangedAfterReview": {"const": true}},
            "required": ["recordChangedAfterReview"]
          },
          "then": {
            "required": ["changeRationale"]
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doubleAnnotation", "reconciled", "reconciliationNotes"],
      "properties": {
        "doubleAnnotation": {"type": "boolean"},
        "reconciled": {"type": "boolean"},
        "reconciliationNotes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "residualQuestions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"template": {"const": false}},
        "required": ["template"]
      },
      "then": {
        "properties": {
          "sourceArtifacts": {"minItems": 1},
          "recordSnapshots": {
            "properties": {
              "initial": {"required": ["recordHash", "path"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {"recordChangedAfterReview": {"const": true}},
            "required": ["recordChangedAfterReview"]
          }
        }
      },
      "then": {
        "properties": {
          "recordSnapshots": {"required": ["initial", "reconciled"]}
        }
      }
    }
  ],
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordHash"],
      "properties": {
        "recordHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotationId", "annotatorId", "independent", "elapsedMinutes", "fields"],
      "properties": {
        "annotationId": {"type": "string", "minLength": 1, "maxLength": 128},
        "annotatorId": {"type": "string", "minLength": 1, "maxLength": 128},
        "independent": {"type": "boolean"},
        "elapsedMinutes": {"type": "number", "minimum": 0},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fieldObservation"}
        }
      }
    },
    "fieldObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "requiredForProfile", "classification", "sourceArtifactIds"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "requiredForProfile": {"type": "boolean"},
        "classification": {
          "type": "string",
          "enum": ["direct-source", "derived", "interpretive", "unknown", "not-applicable"]
        },
        "sourceArtifactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"classification": {"const": "direct-source"}},
            "required": ["classification"]
          },
          "then": {
            "properties": {"sourceArtifactIds": {"minItems": 1}}
          }
        },
        {
          "if": {
            "properties": {"classification": {"enum": ["derived", "interpretive", "not-applicable"]}},
            "required": ["classification"]
          },
          "then": {"required": ["rationale"]}
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "code", "severity", "message", "disposition", "rationale"],
      "properties": {
        "findingId": {"type": "string", "minLength": 1, "maxLength": 128},
        "code": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["error", "warning"]},
        "path": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "disposition": {
          "type": "string",
          "enum": [
            "confirmed-process-gap",
            "annotation-defect",
            "model-defect",
            "expected-warning",
            "unresolved",
            "other"
          ]
        },
        "rationale": {"type": "string", "minLength": 1},
        "sourceArtifactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
