{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anchor-receipt.schema.json",
  "title": "ENS GDI Phase II Anchor Receipt",
  "description": "Offline-verifiable receipt for an anchored envelope. Trust roots are client-pinned; a copied PEM in verifierMaterial is not an independent root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "envelopeDigestSha256",
    "anchorId",
    "anchoredAt",
    "verifierMaterial"
  ],
  "properties": {
    "profileId": {
      "type": "string",
      "enum": [
        "rekor-v1",
        "rekor-v1-recorded-fixture",
        "rekor-v2",
        "rekor-v2-recorded-fixture",
        "rfc3161",
        "rfc3161-recorded-fixture",
        "ethereum",
        "ethereum-calldata-fixture"
      ]
    },
    "envelopeDigestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "anchorId": { "type": "string", "minLength": 1 },
    "anchoredAt": { "type": "string", "format": "date-time" },
    "logIndex": { "type": ["integer", "null"], "minimum": 0 },
    "verifierMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "bodyB64": { "type": "string", "minLength": 1 },
        "integratedTime": { "type": "integer", "minimum": 0 },
        "logIdHex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signedEntryTimestampB64": { "type": "string", "minLength": 1 },
        "inclusionProof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logIndex", "treeSize", "rootHash", "hashes"],
          "properties": {
            "logIndex": { "type": "integer", "minimum": 0 },
            "treeSize": { "type": "integer", "minimum": 1 },
            "rootHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "hashes": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "checkpoint": { "type": "string", "minLength": 1 },
        "uuid": { "type": "string", "minLength": 1 },
        "logIdentity": { "type": "string", "minLength": 1 },
        "shard": { "type": "string", "minLength": 1 },
        "logSubmissionSignature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "algorithm", "signatureB64", "verifierPublicKeyPemB64", "nonClaim"],
          "properties": {
            "role": { "const": "technical-log-submission-only" },
            "algorithm": { "type": "string", "minLength": 1 },
            "signatureB64": { "type": "string", "minLength": 1 },
            "verifierPublicKeyPemB64": { "type": "string", "minLength": 1 },
            "nonClaim": { "type": "string", "minLength": 1 }
          }
        },
        "tsTokenB64": { "type": "string", "minLength": 1 },
        "tsaCertificatePem": { "type": "string", "minLength": 1 },
        "tstInfoDerB64": { "type": "string", "minLength": 1 },
        "signatureB64": { "type": "string", "minLength": 1 },
        "chainId": { "type": "integer", "minimum": 1 },
        "txHash": { "type": "string", "minLength": 1 },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "blockTimestamp": { "type": "integer", "minimum": 0 },
        "calldataHex": { "type": "string", "minLength": 1 },
        "envelopeDigestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "rekor-v1-offline" } },
            "required": ["kind"]
          },
          "then": {
            "required": [
              "bodyB64",
              "integratedTime",
              "logIdHex",
              "signedEntryTimestampB64",
              "inclusionProof",
              "checkpoint",
              "uuid"
            ]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "rekor-v2-offline" } },
            "required": ["kind"]
          },
          "then": {
            "required": [
              "bodyB64",
              "integratedTime",
              "logIdHex",
              "logIdentity",
              "shard",
              "signedEntryTimestampB64",
              "inclusionProof",
              "checkpoint",
              "uuid",
              "logSubmissionSignature"
            ]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "rfc3161-fixture-v1" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["tstInfoDerB64", "signatureB64", "tsaCertificatePem"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "rfc3161-offline" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["tsTokenB64", "tsaCertificatePem"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "ethereum-calldata-offline" } },
            "required": ["kind"]
          },
          "then": {
            "required": [
              "chainId",
              "txHash",
              "blockNumber",
              "blockTimestamp",
              "calldataHex",
              "envelopeDigestSha256"
            ]
          }
        }
      ]
    }
  }
}
