{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-bundle.schema.json",
  "title": "ENS GDI Phase II Evidence Bundle",
  "description": "Graph of envelope, receipt, optional reveal, optional run attestation, optional replay report, and a v0.1 decision record. Phase II objects MUST NOT populate decision.authorityKind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundleVersion", "envelope", "receipt", "revealStatus", "decisionRecord"],
  "properties": {
    "bundleVersion": { "const": "1" },
    "envelope": { "$ref": "commitment-envelope.schema.json" },
    "receipt": { "$ref": "anchor-receipt.schema.json" },
    "revealStatus": {
      "type": "string",
      "enum": ["committed", "revealed", "selective-audit", "withheld"]
    },
    "manifest": { "type": ["object", "null"] },
    "saltHex": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "selectiveAuditResult": { "type": ["object", "null"] },
    "runAttestation": { "type": ["object", "null"] },
    "runPublicKeyPem": { "type": ["string", "null"] },
    "replayReport": { "type": ["object", "null"] },
    "layerInputs": { "type": ["object", "null"] },
    "decisionRecord": { "type": "object" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revealStatus": { "const": "revealed" } },
        "required": ["revealStatus"]
      },
      "then": {
        "required": ["manifest", "saltHex"]
      }
    },
    {
      "if": {
        "properties": { "revealStatus": { "const": "withheld" } },
        "required": ["revealStatus"]
      },
      "then": {
        "properties": {
          "manifest": { "type": "null" },
          "saltHex": { "type": "null" }
        }
      }
    }
  ]
}
