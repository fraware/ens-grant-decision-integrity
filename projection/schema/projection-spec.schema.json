{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projection-spec.schema.json",
  "title": "ENS GDI Public Projection Spec",
  "description": "Versioned rules for projecting a confidential canonical record to a public decision record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "domain", "fieldAllowlist", "redactions"],
  "properties": {
    "specVersion": { "type": "string", "const": "1" },
    "domain": { "type": "string", "const": "ens-gdi/public-projection/v1" },
    "sourceUri": { "type": "string", "format": "uri" },
    "fieldAllowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "category"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["privacy", "security", "commercial", "legal", "contractual", "other"]
          },
          "explanation": { "type": "string" }
        }
      }
    }
  }
}
